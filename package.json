{
  "name": "kubetimr",
  "version": "2.0.0",
  "description": "A clean speedcubing timer with random state scrambles, a stats page per cube and csTimer import.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "rubiks-cube",
    "speedcubing",
    "timer",
    "cubing",
    "wca",
    "scramble",
    "offline-first"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "cubing": "^0.61.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
